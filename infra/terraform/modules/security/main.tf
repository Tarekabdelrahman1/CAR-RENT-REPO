resource "aws_security_group" "public_alb_sg" {
  name   = "${local.prefix}-public-alb-sg"
  vpc_id = var.vpc_id
 
  dynamic "ingress" {
    for_each = local.alb_ports
    content {
      from_port   = ingress.value
      to_port     = ingress.value
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${local.prefix}-public-alb-sg"
    Team = lookup(var.extra_tags, "Team", "General")
  }
}

resource "aws_security_group" "web_tier_sg" {
  name   = "${local.prefix}-web-tier-sg"
  vpc_id = var.vpc_id

  ingress {
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.public_alb_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

